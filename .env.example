############################################################
# LEION MCP — EXAMPLE ENVIRONMENT
# Copy this file to `.env` and replace placeholders.
# Keep paths/URLs machine-specific in `.env`, not in code.
############################################################

##############################
# MCP SERVER
##############################
MCP_ACCESS_TOKEN=change_me
MCP_ALLOWED_ORIGINS=chatgpt.com,localhost
MCP_DEBUG=true

##############################
# LLM PROVIDERS
##############################
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
MISTRAL_API_KEY=sk-mistral-xxx
GROQ_API_KEY=gsk_xxx
OPENROUTER_API_KEY=sk-or-xxx
OLLAMA_BASE_URL=http://localhost:11434

##############################
# COMPOSIO / WEBHOOKS
##############################
COMPOSIO_API_KEY=sk_composio_xxx
COMPOSIO_BASE_URL=https://api.composio.dev
COMPOSIO_WEBHOOK_URL=https://your-domain.example/webhook
COMPOSIO_WEBHOOK_SECRET=change_me

##############################
# FLOWISE / RUBE / ZAPIER
##############################
FLOWISE_BASE_URL=http://localhost:3000
RUBE_BASE_URL=http://localhost:3005
ZAPIER_HOOK_BASE_URL=https://hooks.zapier.com/hooks/catch/XXXX/YYYY

##############################
# VECTOR STORE / MEMORY
##############################
# Default is the deterministic local JSON namespace store under
# LEION_WORKSPACE_ROOT. Set MEMORY_BACKEND=http only when an external vector
# service is intentionally available.
MEMORY_BACKEND=local
VECTOR_STORE_BASE_URL=http://localhost:8085
# Portable examples:
# Windows: D:/claude_code/leion_workspace
# macOS/Linux: /Users/yourname/leion_workspace or /home/yourname/leion_workspace
LEION_WORKSPACE_ROOT=
WORKFLOW_DEFINITIONS_DIR=

##############################
# LEGACY / EXTERNAL ENGINES
##############################
LEION_WORKFLOW_API=http://localhost:3101
WORKFLOW_RUNNER=local
LEION_ENGINE_API_URL=http://localhost:8001
LEION_ENGINE_API_TIMEOUT=60

##############################
# REDIS
##############################
REDIS_URL=redis://localhost:6379/0

##############################
# ROUTER BACKENDS
##############################
MCP_FS_URL=http://localhost:7001
MCP_GIT_URL=http://localhost:7002
MCP_WORKFLOWS_URL=http://localhost:7003
MCP_MEMORY_URL=http://localhost:7004
MCP_AGENTS_URL=http://localhost:7005
MCP_INTEGRATIONS_URL=http://localhost:7006
MCP_DEV_QUALITY_URL=http://localhost:7007
MCP_BUSINESS_URL=http://localhost:7008
MCP_UI_URL=http://localhost:7009
MCP_CONTROL_CENTER_URL=http://localhost:7010
MCP_RUNTIME_URL=http://localhost:7011
MCP_WP_URL=http://localhost:7012
MCP_N8N_URL=http://localhost:7013
MCP_REVENUE_URL=http://localhost:7014
MCP_DEVELOPMENT_URL=http://localhost:7015

##############################
# FILESYSTEM / WORDPRESS
##############################
FS_ROOT=/data
WP_BASE_URL=https://example.com
WP_USER=your-user
WP_APP_PASSWORD=your-app-password
WP_TIMEOUT=60


##############################
# LEION CLI RUNTIME MCP
##############################
# Path to the local cli_leion_engine clone.
# Windows example: D:/Leion/cli_leion_engine
LEION_CLI_REPO=
# Optional override for the built JS entry. Defaults to:
# <LEION_CLI_REPO>/packages/cli/out/index.js
LEION_CLI_ENTRY=
LEION_NODE_BIN=node
# Required for workspace-bearing runtime calls. Separate multiple roots with
# the platform path separator (';' on Windows, ':' on macOS/Linux).
# Windows example: D:/Leion;E:/Projects
LEION_RUNTIME_ALLOWED_ROOTS=


##############################
# N8N LOCAL PUBLIC API
##############################
N8N_API_BASE_URL=http://localhost:5678/api/v1
N8N_API_KEY=
# Read-only by default. Set true only when you want MCP clients to create,
# update, activate, or deactivate workflows through the public API.
N8N_MUTATIONS_ENABLED=false
